+    "american nor port",
+    "american not port",
+    "american or port",
+    "american voltage source",
+    "american xnor port",
+    "american xor port",
+    "ammeter",
+    "amp",
+    "bandpass",
+    "bandstop",
+    "bare7seg",
+    "bareRXantenna",
+    "bareTXantenna",
+    "bareantenna",
+    "buffer",
+    "bulb",
+    "buzzer",
+    "circulator",
+    "closed double solder jumper",
